# ── Core ─────────────────────────────────────────────────────────────
DATABASE_URL=postgres://payload:payload@localhost:5434/payload_playground
# Any long random string (at least 32 characters).
PAYLOAD_SECRET=change-me-to-a-long-random-string-0123456789
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── Postgres container (docker-compose) ──────────────────────────────
POSTGRES_USER=payload
POSTGRES_PASSWORD=payload
POSTGRES_DB=payload_playground

# ── MinIO (local only — never AWS) ───────────────────────────────────
# The app refuses to start if MINIO_ENDPOINT is missing or points to amazonaws.com.
MINIO_ENDPOINT=http://localhost:9200
MINIO_REGION=us-east-1
# App user created by the minio-init container (NOT the root user).
MINIO_ACCESS_KEY=payload-playground-app
MINIO_SECRET_KEY=payload-playground-app-secret
MINIO_BUCKET=payload-playground
# Optional folder inside the bucket (the Docker app uses "app" so it never shares files with dev).
MINIO_PREFIX=
# Root login for the MinIO console (http://localhost:9201) and minio-init only.
MINIO_ROOT_USER=payload-playground-root
MINIO_ROOT_PASSWORD=payload-playground-root-secret
MINIO_CORS_ORIGIN=http://localhost:3000

# ── Email (Mailpit, UI on http://localhost:8025) ─────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=no-reply@payload-playground.local
SMTP_FROM_NAME=Payload Playground

# ── Machine translation ──────────────────────────────────────────────
# libretranslate (local Docker, free) | deepl (requires DEEPL_API_KEY)
TRANSLATE_PROVIDER=libretranslate
LIBRETRANSLATE_URL=http://localhost:5000
# Host port of the container; change both if 5000 is taken on your machine.
LIBRETRANSLATE_PORT=5000
DEEPL_API_KEY=
