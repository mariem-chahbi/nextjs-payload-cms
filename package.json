{
  "name": "payload-playground",
  "version": "1.0.0",
  "private": true,
  "description": "Test project evaluating Payload CMS 3 + Next.js: Postgres, roles, MinIO storage, en/ar localization by region, fully CMS-driven frontend.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "typecheck": "tsc --noEmit",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "test": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "test:watch": "cross-env NODE_OPTIONS=--no-deprecation vitest --config ./vitest.config.mts",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run ./src/seed/index.ts",
    "seed:assets": "tsx ./src/seed/generate-assets.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/email-nodemailer": "3.91.0",
    "@payloadcms/live-preview-react": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/plugin-form-builder": "3.91.0",
    "@payloadcms/plugin-seo": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/storage-s3": "3.91.0",
    "@payloadcms/translations": "3.91.0",
    "@payloadcms/ui": "3.91.0",
    "cross-env": "7.0.3",
    "dotenv": "16.4.7",
    "exceljs": "4.4.0",
    "graphql": "16.14.2",
    "next": "16.4.3",
    "payload": "3.91.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.19.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "28.0.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "packageManager": "pnpm@12.16.1"
}
